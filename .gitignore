__pycache__/
*.pyc
.DS_Store
node_modules/
.idea/

# NGINX cache contents are generated at runtime - keep the folder (see
# nginx/cache/.gitkeep) but don't commit cached files themselves.
nginx/cache/*
!nginx/cache/.gitkeep

# Same idea for the SQLite "database" file - keep the folder, not the data.
python-app/data/*
!python-app/data/.gitkeep
